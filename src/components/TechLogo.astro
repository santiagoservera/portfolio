---
/**
 * Logo oficial de una tecnología (SVG de devicon, licencia MIT).
 * Se sirve como archivo aparte con carga diferida: los logos están debajo del primer
 * pantallazo y así no suman peso al HTML inicial. Son decorativos (el nombre está en la lista).
 */
import type { TechId } from '../data/stack';

interface Props {
  id: TechId;
  class?: string;
}

const logos = import.meta.glob<string>('../assets/tech/*.svg', { query: '?url', import: 'default', eager: true });
const { id, class: className } = Astro.props;
const src = logos[`../assets/tech/${id}.svg`];

if (!src) throw new Error(`TechLogo: no existe src/assets/tech/${id}.svg`);
---

<span class:list={['tech-logo', className]}>
  <img src={src} alt="" width="128" height="128" loading="lazy" decoding="async" />
</span>

<style>
  .tech-logo {
    display: inline-grid;
    place-items: center;
  }

  .tech-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
