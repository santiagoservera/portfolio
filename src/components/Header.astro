---
import { nav, profile } from '../data/profile';
---

<header class="header">
  <div class="header__inner container">
    <a href="#top" class="brand" aria-label={`${profile.name}, volver al inicio`}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none">
          <ellipse cx="16" cy="16" rx="13" ry="5.5" stroke="currentColor" stroke-width="1.4" />
          <ellipse cx="16" cy="16" rx="7.5" ry="3" stroke="currentColor" stroke-width="1.4" opacity=".6" />
          <ellipse cx="16" cy="16" rx="2.6" ry="1.1" fill="currentColor" />
        </svg>
      </span>
      <span class="brand__name">santiago<span class="accent">.</span>servera</span>
    </a>

    <nav id="site-menu" class="nav" aria-label="Principal">
      <ol class="nav__list">
        {
          nav.map((item, i) => (
            <li>
              <a href={`#${item.id}`} class="nav__link" data-nav-link>
                <span class="nav__idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
      <div class="nav__mobile-extra">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <span>{profile.location}</span>
      </div>
    </nav>

    <a href="#contacto" class="header__cta btn">Hablemos</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Abrir menú" data-menu-toggle>
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      background-color 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out),
      backdrop-filter 0.4s;
    border-bottom: 1px solid transparent;
  }

  :global(html.is-scrolled) .header {
    background: rgb(9 9 11 / 0.72);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: var(--c-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--f-mono);
    font-size: var(--fs-sm);
    letter-spacing: -0.01em;
    position: relative;
    z-index: 2;
  }

  .brand__mark {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    color: var(--c-wine-tint);
    transition: transform 0.8s var(--ease-out);
  }

  .brand:hover .brand__mark {
    transform: rotate(180deg);
  }

  .nav {
    margin-left: auto;
  }

  .nav__list {
    display: flex;
    gap: 0.25rem;
  }

  .nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    font-size: var(--fs-sm);
    color: var(--c-fg-muted);
    transition:
      color 0.25s,
      background-color 0.25s;
  }

  .nav__idx {
    font-family: var(--f-mono);
    font-size: 0.65rem;
    color: var(--c-fg-dim);
  }

  .nav__link:hover,
  .nav__link[aria-current] {
    color: var(--c-fg);
  }

  .nav__link[aria-current] {
    background: rgb(244 244 245 / 0.06);
  }

  .nav__link[aria-current] .nav__idx {
    color: var(--c-wine-tint);
  }

  .nav__mobile-extra {
    display: none;
  }

  .header__cta {
    min-height: 40px;
    padding: 0.5rem 1.1rem;
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 899px) {
    .header__cta {
      display: none;
    }

    .menu-toggle {
      position: relative;
      z-index: 2;
      display: grid;
      place-content: center;
      gap: 6px;
      width: 44px;
      height: 44px;
      margin-left: auto;
      border: 1px solid var(--c-line-strong);
      border-radius: 999px;
    }

    .menu-toggle span {
      display: block;
      width: 18px;
      height: 1.5px;
      background: currentColor;
      transition: transform 0.4s var(--ease-out);
    }

    .menu-toggle[aria-expanded='true'] span:first-child {
      transform: translateY(3.75px) rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] span:last-child {
      transform: translateY(-3.75px) rotate(-45deg);
    }

    .nav {
      position: fixed;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 7rem var(--gutter) 2.5rem;
      background: var(--c-black);
      visibility: hidden;
      opacity: 0;
      transition:
        opacity 0.35s var(--ease-out),
        visibility 0.35s;
    }

    :global(html.menu-open) .nav {
      visibility: visible;
      opacity: 1;
    }

    :global(html.menu-open) {
      overflow: hidden;
    }

    /* backdrop-filter crea un containing block para position:fixed; se quita con el menú abierto */
    :global(html.menu-open) .header {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--c-black);
    }

    .nav__list {
      flex-direction: column;
      gap: 0;
    }

    .nav__link {
      width: 100%;
      padding: 0.9rem 0;
      border-radius: 0;
      border-bottom: 1px solid var(--c-line);
      font-size: clamp(1.75rem, 8vw, 2.5rem);
      letter-spacing: -0.03em;
      color: var(--c-fg);
      gap: 1rem;
    }

    .nav__link[aria-current] {
      background: none;
    }

    .nav__idx {
      font-size: var(--fs-xs);
    }

    .nav__mobile-extra {
      display: grid;
      gap: 0.35rem;
      font-family: var(--f-mono);
      font-size: var(--fs-sm);
      color: var(--c-fg-muted);
    }
  }
</style>
