---
import SectionHead from './SectionHead.astro';
import { experience } from '../data/experience';
import AsciiPiece from './AsciiPiece.astro';

// La trayectoria contada como una sesión de terminal (mismos datos que la lista).
const session = [
  ['whoami', 0.1, ['santiago servera · full stack developer']],
  ['git log --oneline --reverse', 0.25, ['a1f3c2e 2024-01 SUINFI · frontend (angular, react)', 0.35, 'b7d91e0 2024-09 freelance · full stack', 0.35, 'c02e8a4 2025-04 Tandem Digital · full stack (vue, node)']],
  ['git status', 0.2, ['On branch main', 'en curso: Tandem Digital + freelance', 'nothing to commit, working tree clean']],
  ['clear', 0, null],
];

---

<section id="experiencia" class="section exp" data-label="Experiencia" aria-labelledby="experiencia-title">
  <div class="container">
    <SectionHead index={2} title="Experiencia" id="experiencia-title" depth="-0.25" />

    <div class="exp__layout">
    <ol class="jobs">
      {
        experience.map((r, i) => (
          <li class="job" data-reveal style={`--d:${i}`}>
            <span class="job__when mono">
              <time datetime={r.startISO}>{r.start}</time> — {r.end}
            </span>
            <h3 class="job__company">
              {r.company}
              {r.current && (
                <>
                  <span class="live" aria-hidden="true" />
                  <span class="sr-only">(actual)</span>
                </>
              )}
            </h3>
            <span class="job__role">{r.role}</span>
            <p class="job__summary">{r.summary}</p>
          </li>
        ))
      }
    </ol>

    <!-- La misma trayectoria, contada como una sesión de terminal (solo escritorio) -->
    <div class="exp__term bg-art" aria-hidden="true">
      <AsciiPiece custom="terminal" options={{ prompt: '~/santiago $', title: '~/santiago', session, rows: 14 }} />
    </div>
    </div>
  </div>
</section>

<style>
  /* La terminal va detrás de la lista: misma historia, como textura de fondo */
  .exp__layout {
    position: relative;
  }

  /* en el margen derecho: arranca donde termina el texto y se pierde hacia el borde de la pantalla */
  .exp__term {
    left: calc(100% - 5.5rem);
    top: 50%;
    translate: 0 -50%;
    --bg-art-opacity: 0.4;
    -webkit-mask-image: linear-gradient(to right, #000 25%, transparent 85%);
    mask-image: linear-gradient(to right, #000 25%, transparent 85%);
  }

  .exp__term :global(.ascii-piece) {
    font-size: 12px;
    zoom: 1;
  }

  /* Tablet y celular: sin márgenes laterales, la lista ocupa todo el ancho y la terminal
     quedaría encima del texto: no se muestra */
  @media (max-width: 1099px) {
    .exp__term {
      display: none;
    }
  }

  .jobs {
    border-top: 1px solid var(--c-line-strong);
  }

  .job {
    display: grid;
    grid-template-columns: 11rem 13rem 12rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    padding: 1.25rem 0.5rem;
    border-bottom: 1px solid var(--c-line);
    transition: background-color 0.3s;
  }

  .job:hover {
    background: rgb(23 23 26 / 0.6);
  }

  .job__when {
    color: var(--c-fg-dim);
  }

  .job__company {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-md);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-wine-tint);
    box-shadow: 0 0 10px var(--c-glow);
  }

  .job__role {
    color: var(--c-fg-muted);
    font-size: var(--fs-sm);
  }

  .job__summary {
    color: var(--c-fg-muted);
    font-size: var(--fs-sm);
  }

  @media (max-width: 1099px) {
    .job {
      grid-template-columns: 10rem minmax(0, 1fr);
    }

    .job__role,
    .job__summary {
      grid-column: 2;
    }
  }

  @media (max-width: 600px) {
    .job {
      grid-template-columns: minmax(0, 1fr);
      padding-inline: 0;
    }

    .job__role,
    .job__summary {
      grid-column: 1;
    }
  }
</style>
