---
import SectionHead from './SectionHead.astro';
import { experience } from '../data/experience';

// Línea de tiempo 3D de la figura viajera, construida con las fechas reales.
const toMonths = (iso: string) => {
  const [y, m] = iso.split('-').map(Number);
  return y * 12 + (m - 1);
};
const now = new Date();
const nowM = now.getFullYear() * 12 + now.getMonth();
const minM = Math.min(...experience.map((r) => toMonths(r.startISO)));
const span = Math.max(1, nowM - minM);
const roles = experience.map((r) => ({
  s: (toMonths(r.startISO) - minM) / span,
  e: ((r.current || !r.endISO ? nowM : toMonths(r.endISO)) - minM) / span,
  current: r.current,
}));
---

<section id="experiencia" class="section" data-field="streams" data-label="Experiencia" aria-labelledby="experiencia-title">
  <div class="container">
    <SectionHead index={2} title="Experiencia" id="experiencia-title" depth="-0.25" />

    <ol class="jobs">
      {
        experience.map((r, i) => (
          <li class="job" data-field-react="band" data-reveal style={`--d:${i}`}>
            <span class="job__when mono">
              <time datetime={r.startISO}>{r.start}</time> — {r.end}
            </span>
            <h3 class="job__company">
              {r.company}
              {r.current && (
                <>
                  <span class="live" aria-hidden="true" />
                  <span class="sr-only">(actual)</span>
                </>
              )}
            </h3>
            <span class="job__role">{r.role}</span>
            <p class="job__summary">{r.summary}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .jobs {
    border-top: 1px solid var(--c-line-strong);
  }

  .job {
    display: grid;
    grid-template-columns: 11rem 13rem 12rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    padding: 1.25rem 0.5rem;
    border-bottom: 1px solid var(--c-line);
    transition: background-color 0.3s;
  }

  .job:hover {
    background: rgb(23 23 26 / 0.6);
  }

  .job__when {
    color: var(--c-fg-dim);
  }

  .job__company {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-md);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-wine-tint);
    box-shadow: 0 0 10px var(--c-glow);
  }

  .job__role {
    color: var(--c-fg-muted);
    font-size: var(--fs-sm);
  }

  .job__summary {
    color: var(--c-fg-muted);
    font-size: var(--fs-sm);
  }

  @media (max-width: 1099px) {
    .job {
      grid-template-columns: 10rem minmax(0, 1fr);
    }

    .job__role {
      grid-column: 2;
    }

    .job__summary {
      grid-column: 2;
    }
  }

  @media (max-width: 600px) {
    .job {
      grid-template-columns: minmax(0, 1fr);
      padding-inline: 0;
    }

    .job__role,
    .job__summary {
      grid-column: 1;
    }
  }
</style>
