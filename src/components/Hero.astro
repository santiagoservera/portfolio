---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { asciiTunnel } from '../lib/ascii';

const tunnel = asciiTunnel(150, 52);
// versión para celular: proporción vertical, letra legible sin escalar
const tunnelMobile = asciiTunnel(54, 40);
---

<section id="top" class="hero" data-label="Inicio" aria-labelledby="hero-title">
  <!--
    Escritorio: el stage ocupa una pantalla y el canvas es fijo (la cámara bucea mientras el hero sale).
    Móvil: el hero es más alto y el stage queda fijado (sticky); el buceo ocurre con la pantalla quieta.
  -->
  <div class="hero__stage" data-hero-stage>
  <!-- Fallback ASCII: visible sin WebGL / sin JS. El canvas lo reemplaza si WebGL inicia. -->
  <pre class="hero__ascii hero__ascii--wide" aria-hidden="true">{tunnel}</pre>
  <pre class="hero__ascii hero__ascii--narrow" aria-hidden="true">{tunnelMobile}</pre>
  <canvas class="hero__canvas" aria-hidden="true" data-wormhole></canvas>
  <div class="hero__vignette" aria-hidden="true"></div>
  <p class="hero__hint mono" aria-hidden="true">← deslizá para girar · tocá →</p>

  <div class="hero__inner container">
    <div class="hero__meta mono" aria-hidden="true">
      <span>[ portfolio ]</span>
      <span class="hero__meta-line"></span>
      <span>{profile.coords}</span>
    </div>

    <h1 id="hero-title" class="hero__title">
      <span class="hero__first hero-rise">{profile.firstName}</span>
      <span class="hero__last serif hero-rise" style="--d:1">{profile.lastName}</span>
      <span class="sr-only">, {profile.role}</span>
    </h1>

    <div class="hero__aside">
      <p class="hero__role mono" aria-hidden="true">
        <span class="hero__dot"></span>
        <span data-scramble data-duration="1200">{profile.role}</span>
      </p>
      <p class="hero__lede hero-rise" style="--d:2">
        Desarrollo aplicaciones web y sistemas de gestión, del backend a la interfaz.
      </p>
      <div class="hero__actions hero-rise" style="--d:3">
        <a href="#proyectos" class="btn btn--primary">
          Ver proyectos
          <Icon name="arrow-down" />
        </a>
        <a href="#contacto" class="btn">Contacto</a>
        <div class="hero__social">
          <a href={profile.links.github} class="social" target="_blank" rel="noopener noreferrer" aria-label="GitHub (se abre en una pestaña nueva)">
            <Icon name="github" />
          </a>
          <a href={profile.links.linkedin} class="social" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (se abre en una pestaña nueva)">
            <Icon name="linkedin" />
          </a>
        </div>
      </div>
    </div>

    <div class="hero__foot mono">
      <span class="hero__status"><span class="pulse" aria-hidden="true"></span> Abierto a nuevas oportunidades</span>
      <span class="hero__loc">{profile.location}</span>
      <span class="hero__scroll" aria-hidden="true">Scroll ↓</span>
    </div>
  </div>
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-wormhole]');
  const hero = document.querySelector<HTMLElement>('.hero');
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  if (canvas && hero && stage) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // El modo se decide al cargar: rotar el teléfono no cambia de experiencia a mitad de camino.
    const mobile = window.matchMedia('(max-width: 760px)').matches;

    // Progreso del buceo en móvil: 0 → 1 mientras el stage está fijado.
    const getProgress = () => {
      const rect = hero.getBoundingClientRect();
      const range = rect.height - window.innerHeight;
      return range > 0 ? Math.min(Math.max(-rect.top / range, 0), 1) : 0;
    };

    if (mobile && !reduced) {
      // El contenido del hero se aparta mientras la cámara atraviesa el portal.
      let ticking = false;
      const update = () => {
        ticking = false;
        const p = getProgress();
        hero.style.setProperty('--hp', p.toFixed(3));
        hero.classList.toggle('is-diving', p > 0.3);
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true },
      );
      update();
      // La pista se oculta sola si nadie interactúa.
      window.setTimeout(() => hero.classList.add('hint-done'), 7000);
    }

    const fail = () => hero.classList.remove('has-webgl');
    // Carga diferida: el contenido nunca espera al 3D.
    const start = () =>
      import('../scripts/wormhole')
        .then(({ mountWormhole }) =>
          mountWormhole({
            canvas,
            track: hero,
            reducedMotion: reduced,
            mobile,
            getProgress: mobile ? getProgress : undefined,
            touchTarget: stage,
            onInteract: () => hero.classList.add('hint-done'),
            onReady: () => hero.classList.add('has-webgl'),
            onFail: fail,
          }),
        )
        .catch(fail);
    // En celular el 3D se despierta con el primer gesto (tocar o scrollear): hasta ahí se ve
    // la versión ASCII del túnel, y la carga de la página no compite con la GPU.
    if (mobile) {
      let started = false;
      const go = () => {
        if (started) return;
        started = true;
        start();
      };
      for (const ev of ['touchstart', 'pointerdown', 'scroll', 'keydown'] as const) window.addEventListener(ev, go, { once: true, passive: true });
    } else if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 600 });
    else setTimeout(start, 120);
  }
</script>

<style>
  .hero {
    --hp: 0;
    position: relative;
    min-height: 100svh;
    display: flex;
    isolation: isolate;
  }

  /* Entrada del hero: solo movimiento (sin opacidad 0), así el contenido es visible
     desde el primer cuadro y cuenta para el Largest Contentful Paint. */
  .hero-rise {
    animation: hero-rise 1.1s var(--ease-out) both;
    animation-delay: calc(var(--d, 0) * 90ms);
  }

  @keyframes hero-rise {
    from {
      transform: translate3d(0, 0.4em, 0);
    }
    to {
      transform: none;
    }
  }

  .hero__stage {
    position: relative;
    flex: 1;
    display: flex;
    width: 100%;
    min-height: 100svh;
  }

  .hero__hint {
    display: none;
  }


  .hero__canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    opacity: 0;
    transition: opacity 1.6s var(--ease-out);
    pointer-events: none;
  }

  .hero.has-webgl .hero__canvas {
    opacity: 1;
  }

  .hero__ascii {
    position: absolute;
    inset: 0;
    z-index: -3;
    margin: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    /* fuente monoespaciada del sistema: se pinta en el primer cuadro sin esperar descargas */
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', monospace;
    /* tamaño legible para el navegador; se achica visualmente con scale */
    font-size: 12px;
    line-height: 1.15;
    scale: 0.9;
    color: var(--c-wine-2);
    opacity: 0.75;
    transition: opacity 1s var(--ease-out);
    user-select: none;
    -webkit-mask-image: radial-gradient(ellipse at 60% 50%, #000 30%, transparent 75%);
    mask-image: radial-gradient(ellipse at 60% 50%, #000 30%, transparent 75%);
  }

  .hero__ascii--narrow {
    display: none;
  }

  .hero.has-webgl .hero__ascii {
    opacity: 0;
  }

  .hero__vignette {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 60% at 15% 85%, rgb(9 9 11 / 0.85), transparent 70%),
      linear-gradient(to bottom, rgb(9 9 11 / 0.55), transparent 25%);
    /* se desvanece hacia abajo para no marcar un corte contra la galaxia */
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    grid-template-rows: auto 1fr auto;
    column-gap: 3rem;
    padding-top: 7rem;
    padding-bottom: 2rem;
  }

  .hero__meta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--c-fg-dim);
  }

  .hero__meta-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--c-line-strong), transparent);
  }

  .hero__title {
    grid-column: 1;
    align-self: end;
    display: grid;
    font-size: var(--fs-3xl);
    font-weight: 500;
    line-height: 0.86;
    letter-spacing: -0.055em;
    padding-bottom: 0.5rem;
  }

  .hero__last {
    padding-left: 0.55em;
    font-size: 1.04em;
    letter-spacing: -0.02em;
    color: var(--c-white);
  }

  .hero__aside {
    grid-column: 2;
    align-self: end;
    display: grid;
    gap: 1.5rem;
    padding-bottom: 1.6rem;
  }

  .hero__role {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--c-wine-tint);
    font-size: var(--fs-sm);
  }

  .hero__dot {
    width: 8px;
    height: 8px;
    border: 1px solid currentColor;
    transform: rotate(45deg);
  }

  .hero__lede {
    color: var(--c-fg-muted);
    font-size: var(--fs-md);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero__social {
    display: flex;
    gap: 0.5rem;
  }

  .social {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1px solid var(--c-line-strong);
    color: var(--c-fg-muted);
    transition:
      color 0.25s,
      border-color 0.25s,
      background-color 0.25s;
  }

  .social :global(svg) {
    width: 18px;
    height: 18px;
  }

  .social:hover {
    color: var(--c-white);
    border-color: var(--c-wine-2);
    background: rgb(109 33 60 / 0.35);
  }

  .hero__foot {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line);
    color: var(--c-fg-muted);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--c-fg);
  }

  .pulse {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-wine-tint);
  }

  .pulse::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--c-wine-tint);
    animation: pulse 2.4s var(--ease-out) infinite;
  }

  @keyframes pulse {
    from {
      transform: scale(0.6);
      opacity: 1;
    }
    to {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .hero__scroll {
    margin-left: auto;
    color: var(--c-fg-dim);
  }

  @media (max-width: 899px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr auto auto;
      padding-top: 6rem;
    }

    .hero__title {
      font-size: clamp(3.4rem, 17vw, 7rem);
      padding-bottom: 1.5rem;
    }

    .hero__aside {
      grid-column: 1;
    }

    .hero__vignette {
      background:
        linear-gradient(to bottom, rgb(9 9 11 / 0.5), transparent 25%, rgb(9 9 11 / 0.6) 55%, rgb(9 9 11 / 0.75));
    }

    .hero__scroll {
      display: none;
    }
  }

  /* ==========================================================================
     Móvil: experiencia propia, no una versión achicada del escritorio.
     El portal vive en la mitad superior, el contenido abajo; al scrollear la
     pantalla queda fija y la cámara atraviesa el portal antes de seguir.
     ========================================================================== */
  @media (max-width: 760px) {
    .hero {
      display: block;
      height: 160svh;
      /* la sección siguiente entra mientras el portal todavía se va: sin tramo vacío */
      margin-bottom: -45svh;
    }

    .hero__stage {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 0;
      overflow: hidden;
      /* el scroll vertical es del navegador; los swipes horizontales giran el túnel */
      touch-action: pan-y;
    }

    .hero__canvas {
      position: absolute;
      transform: scale(0.5);
      transition:
        opacity 1.2s var(--ease-out),
        transform 2.2s var(--ease-out);
    }

    .hero.has-webgl .hero__canvas {
      transform: none;
    }

    .hero__ascii--wide {
      display: none;
    }

    .hero__ascii--narrow {
      display: grid;
      bottom: auto;
      height: 64svh;
      scale: 1;
      place-items: center;
      font-size: 12px;
      line-height: 1.1;
      opacity: 0.9;
      -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 35%, transparent 72%);
      mask-image: radial-gradient(circle at 50% 50%, #000 35%, transparent 72%);
    }

    .hero__vignette {
      background: linear-gradient(to bottom, rgb(9 9 11 / 0.45), transparent 18%, transparent 46%, rgb(9 9 11 / 0.82) 64%);
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero__inner {
      height: 100%;
      grid-template-rows: auto 1fr auto auto auto;
      padding-top: 5.25rem;
      padding-bottom: max(1rem, env(safe-area-inset-bottom));
      /* el contenido se aparta mientras la cámara bucea */
      opacity: calc(1 - var(--hp) * 2.4);
      transform: translate3d(0, calc(var(--hp) * -12svh), 0);
    }

    .hero.is-diving .hero__inner {
      pointer-events: none;
    }

    .hero__title {
      font-size: clamp(3rem, 15.5vw, 4.75rem);
      padding-bottom: 1rem;
    }

    .hero__aside {
      gap: 1rem;
      padding-bottom: 1.1rem;
    }

    .hero__lede {
      font-size: 1rem;
    }

    .hero__actions {
      gap: 0.5rem;
    }

    .hero__actions .btn {
      min-height: 44px;
      padding: 0.6rem 1.1rem;
    }

    .social {
      width: 44px;
      height: 44px;
    }

    .hero__foot {
      padding-top: 1rem;
    }

    .hero__loc {
      display: none;
    }

    /* Pista de interacción bajo el portal */
    .hero__hint {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 49svh;
      z-index: 1;
      text-align: center;
      font-size: 0.62rem;
      color: var(--c-fg-dim);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.6s var(--ease-out);
    }

    .hero.has-webgl .hero__hint {
      opacity: calc(0.9 - var(--hp) * 5);
      animation: hint-breathe 2.8s var(--ease-in-out) 1.6s infinite;
    }

    .hero.hint-done .hero__hint {
      opacity: 0;
      animation: none;
    }
  }

  @keyframes hint-breathe {
    50% {
      letter-spacing: 0.12em;
    }
  }

  /* Movimiento reducido en móvil: sin pantalla fijada ni buceo, un cuadro estático. */
  @media (max-width: 760px) and (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
      margin-bottom: 0;
    }

    .hero__stage {
      position: relative;
      height: 100svh;
    }

    .hero__canvas {
      transform: none;
    }

    .hero__inner {
      opacity: 1;
      transform: none;
    }

    .hero__hint {
      display: none;
    }
  }
</style>
