---
import SectionHead from './SectionHead.astro';
import TechLogo from './TechLogo.astro';
import { stackGroups, type Tech } from '../data/stack';
import { asciiLogos } from '../data/ascii-logos';
import { logoLayers } from '../lib/ascii-logo';

// Todas las tecnologías en órbita: la principal al centro y el resto por anillos.
const all = stackGroups.flatMap((g) => g.items.map((t) => ({ ...t, ring: g.ring })));
const core = all.find((t) => t.main) ?? all[0];
const rings = ([1, 2, 3] as const).map((ring) => {
  const items = all.filter((t) => t.ring === ring && t.id !== core.id);
  const offset = ring * 23; // desfase para que los anillos no queden alineados
  return { ring, items: items.map((t, i) => ({ ...t, angle: offset + (360 / items.length) * i })) };
});
const isMain = (t: Tech) => t.id === core.id;
// El centro muestra en ASCII la tecnología señalada; arranca con la principal.
const first = logoLayers(asciiLogos[core.id]);
const cycle = all.map((t) => t.id);
---

<section id="tecnologias" class="section stack" data-label="Tecnologías" aria-labelledby="tecnologias-title">
  <div class="container stack__grid">
    <div class="stack__head">
      <SectionHead index={4} title="Tecnologías" id="tecnologias-title" depth="-0.75" />
    </div>

    <div class="orbit" aria-hidden="true" data-orbit>
      {
        rings.map(({ ring, items }) => (
          <div class={`ring ring--${ring}`}>
            {items.map((t) => (
              <div class="slot" style={`--t:${t.angle}deg`}>
                <div class="planet" data-planet={t.id}>
                  <div class="planet__inner">
                    <TechLogo id={t.id} class="planet__logo" />
                    <span class="planet__name mono">{t.name}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        ))
      }
      <div class="core" data-planet={core.id}>
        <div class="core__ascii" data-core-ascii data-cycle={cycle.join(',')} data-current={core.id}>
          <div class="core__lo" data-frame={first.lo}></div>
          <div class="core__hi" data-frame={first.hi}></div>
        </div>
      </div>
    </div>

    <dl class="groups">
      {
        stackGroups.map((g, gi) => (
          <div class="group" data-reveal style={`--d:${gi}`}>
            <dt class="group__label mono">{g.label}</dt>
            <dd class="group__items">
              {g.items.map((t) => (
                <span class:list={['item', { 'item--main': isMain(t) }]} data-tech={t.id}>
                  {t.name}
                  {isMain(t) && <span class="item__tag mono">principal</span>}
                </span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>

  </div>
</section>

<script>
  import { asciiLogos } from '../data/ascii-logos';
  import { logoLayers, blendLayer } from '../lib/ascii-logo';
  import type { TechId } from '../data/stack';

  // Centro de la órbita: el logo en ASCII de la tecnología señalada, con un barrido de ruido al cambiar.
  const screen = document.querySelector<HTMLElement>('[data-core-ascii]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let showLogo: (id: string) => void = () => {};
  let hovering = false;
  if (screen) {
    const lo = screen.querySelector<HTMLElement>('.core__lo')!;
    const hi = screen.querySelector<HTMLElement>('.core__hi')!;
    const cycle = (screen.dataset.cycle ?? '').split(',') as TechId[];
    const seed = Array.from({ length: 32 * 16 }, () => Math.random());
    let current = screen.dataset.current as TechId;
    let anim = 0;
    showLogo = (id) => {
      if (id === current || !(id in asciiLogos)) return;
      const from = logoLayers(asciiLogos[current]);
      const to = logoLayers(asciiLogos[id as TechId]);
      current = id as TechId;
      cancelAnimationFrame(anim);
      if (reduce) {
        lo.dataset.frame = to.lo;
        hi.dataset.frame = to.hi;
        return;
      }
      const t0 = performance.now();
      let last = 0;
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / 420);
        if (now - last > 33 || p === 1) {
          last = now;
          lo.dataset.frame = blendLayer(from.lo, to.lo, p, seed);
          hi.dataset.frame = blendLayer(from.hi, to.hi, p, seed);
        }
        if (p < 1) anim = requestAnimationFrame(step);
      };
      anim = requestAnimationFrame(step);
    };

    // Sin puntero (celular) o mientras nadie señala nada: recorre el stack, solo con la órbita a la vista.
    if (!reduce) {
      let i = 0;
      let timer = 0;
      const tick = () => {
        if (hovering || document.hidden) return;
        i = (i + 1) % cycle.length;
        showLogo(cycle[i]);
        document.querySelectorAll<HTMLElement>('[data-planet]').forEach((el) => el.classList.toggle('is-cur', el.dataset.planet === cycle[i]));
      };
      new IntersectionObserver(([e]) => {
        clearInterval(timer);
        if (e.isIntersecting) timer = window.setInterval(tick, 2400);
      }).observe(screen);
    }
  }

  // Al pasar por un nombre de la lista se ilumina su logo en la órbita (y viceversa).
  const orbit = document.querySelector<HTMLElement>('[data-orbit]');
  if (orbit) {
    const highlight = (id: string | null) => {
      document.querySelectorAll<HTMLElement>('[data-planet], [data-tech]').forEach((el) => {
        el.classList.toggle('is-hl', id !== null && (el.dataset.planet === id || el.dataset.tech === id));
      });
      orbit.classList.toggle('has-hl', id !== null);
      hovering = id !== null;
      if (id) showLogo(id);
    };
    document.querySelectorAll<HTMLElement>('[data-tech]').forEach((el) => {
      el.addEventListener('pointerenter', () => highlight(el.dataset.tech ?? null));
      el.addEventListener('pointerleave', () => highlight(null));
    });
    orbit.querySelectorAll<HTMLElement>('[data-planet]').forEach((el) => {
      el.addEventListener('pointerenter', () => highlight(el.dataset.planet ?? null));
      el.addEventListener('pointerleave', () => highlight(null));
    });
  }
</script>

<style>
  /* los anillos giran: sus cajas rotadas no deben generar scroll horizontal */
  .stack {
    overflow-x: clip;
  }

  .stack__grid {
    display: grid;
    grid-template-columns: var(--split-art) var(--split-text);
    align-items: center;
    gap: 2rem var(--split-gap);
  }

  .stack__head {
    grid-column: 1 / -1;
  }

  /* ---------- Órbita ---------- */
  .orbit {
    --planet: 46px;
    position: relative;
    width: min(100%, 500px);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--c-line-strong);
    animation: spin var(--dur) linear infinite;
  }

  .ring--1 {
    inset: 22%;
    --dur: 70s;
  }

  .ring--2 {
    inset: 10%;
    --dur: 110s;
    animation-direction: reverse;
    border-color: var(--c-line);
  }

  .ring--3 {
    inset: 0;
    --dur: 150s;
    border-style: dashed;
    border-color: var(--c-line);
  }

  .slot {
    position: absolute;
    inset: 0;
    transform: rotate(var(--t));
  }

  /* El planeta se ubica sobre el borde del anillo y compensa los giros para quedar derecho. */
  .planet {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--planet);
    height: var(--planet);
    transform: translate(-50%, -50%) rotate(calc(-1 * var(--t)));
  }

  .planet__inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 11px;
    border-radius: 50%;
    background: var(--c-surface);
    border: 1px solid var(--c-line-strong);
    animation: spin var(--dur) linear infinite;
    animation-direction: reverse;
    transition:
      border-color 0.3s,
      box-shadow 0.3s,
      scale 0.4s var(--ease-out),
      opacity 0.3s;
  }

  .ring--2 .planet__inner {
    animation-direction: normal;
  }

  .planet__name {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    translate: -50% 0;
    white-space: nowrap;
    font-size: 0.6rem;
    text-transform: none;
    color: var(--c-fg);
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }

  .planet:hover .planet__inner,
  .planet.is-hl .planet__inner {
    border-color: var(--c-wine-tint);
    box-shadow: 0 0 22px var(--c-glow);
    scale: 1.18;
  }

  .planet:hover .planet__name,
  .planet.is-hl .planet__name {
    opacity: 1;
  }

  .orbit.has-hl .planet:not(.is-hl) .planet__inner {
    opacity: 0.35;
  }

  .orbit:hover .ring,
  .orbit:hover .planet__inner,
  .orbit.has-hl .ring,
  .orbit.has-hl .planet__inner {
    animation-play-state: paused;
  }

  .core {
    position: absolute;
    inset: 37%;
    display: grid;
    place-items: center;
    padding: 5%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(139 46 74 / 0.45), rgb(109 33 60 / 0.12) 62%, transparent 72%);
    box-shadow: inset 0 0 0 1px rgb(214 138 160 / 0.3);
    transition: box-shadow 0.3s;
  }

  .core::before {
    content: '';
    position: absolute;
    inset: -12%;
    border-radius: 50%;
    border: 1px solid rgb(214 138 160 / 0.25);
    animation: breathe 4s var(--ease-in-out) infinite;
  }

  .core.is-hl {
    box-shadow:
      inset 0 0 0 1px var(--c-wine-tint),
      0 0 40px var(--c-glow);
  }

  /* dos capas superpuestas, una por tinta; el texto va en ::before para no contar como texto de la página */
  /* centrado absoluto y escalado con transform: zoom lo corre del centro del círculo */
  .core__ascii {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    scale: var(--core-scale, 0.42);
    display: grid;
    font-family: var(--f-mono);
    font-size: 12px;
    line-height: 1.12;
    user-select: none;
    pointer-events: none;
  }

  .core__ascii > div {
    grid-area: 1 / 1;
  }

  .core__ascii > div::before {
    content: attr(data-frame);
    display: block;
    white-space: pre;
  }

  .core__lo {
    color: var(--c-wine-tint);
  }

  .core__hi {
    color: var(--c-white);
  }

  /* el planeta que se está mostrando en el centro, mientras recorre solo */
  .planet.is-cur .planet__inner {
    border-color: rgb(214 138 160 / 0.6);
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes breathe {
    50% {
      transform: scale(1.08);
      opacity: 0.4;
    }
  }

  /* ---------- Lista por categoría ---------- */
  .groups {
    border-top: 1px solid var(--c-line-strong);
  }

  .group {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--c-line);
  }

  .group__label {
    color: var(--c-fg-dim);
    padding-top: 0.2rem;
  }

  .group__items {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--c-fg-muted);
    cursor: default;
    transition: color 0.2s;
  }

  .item:hover,
  .item.is-hl {
    color: var(--c-white);
  }

  .item--main {
    color: var(--c-fg);
    font-weight: 500;
  }

  .item__tag {
    padding: 0.05rem 0.4rem;
    border: 1px solid rgb(214 138 160 / 0.4);
    border-radius: 999px;
    font-size: 0.6rem;
    color: var(--c-wine-tint);
    font-weight: 400;
  }

  @media (max-width: 899px) {
    .stack__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .orbit {
      --planet: 38px;
      /* deja lugar para que los planetas del anillo exterior no se corten */
      width: min(calc(100% - var(--planet) - 0.5rem), 360px);
    }

    .planet__inner {
      padding: 9px;
    }

    .core__ascii {
      --core-scale: 0.3;
    }
  }

  @media (max-width: 480px) {
    .group {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring,
    .planet__inner,
    .core::before {
      animation: none;
    }
  }
</style>
